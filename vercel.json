{
  "routes": [
    {
      "src": "/(.+)/",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "/sitemap.xml",
      "dest": "/api/sitemap"
    },
    {
      "src": "/",
      "dest": "/api/page?p=/"
    },
    {
      "src": "/index.html",
      "dest": "/api/page?p=/"
    },
    {
      "src": "/auth/telegram/callback",
      "dest": "/api/tg-callback"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/((?!api/).*)",
      "dest": "/api/page?p=/$1"
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "{index.html,app.js,blog.json}",
      "maxDuration": 10
    },
    "api/sitemap.js": {
      "includeFiles": "blog.json",
      "maxDuration": 10
    },
    "api/tg-sync.js": {
      "maxDuration": 60
    },
    "api/tg-bot.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/tg-sync",
      "schedule": "*/10 * * * *"
    }
  ]
}
