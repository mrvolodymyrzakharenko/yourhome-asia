{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/((?!api/)[^.]*)", "destination": "/api/page?p=/$1" }
  ],
  "functions": {
    "api/page.js": { "includeFiles": "{index.html,app.js}", "maxDuration": 10 },
    "api/sitemap.js": { "maxDuration": 10 }
  },
  "headers": [
    { "source": "/robots.txt", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ]
}
